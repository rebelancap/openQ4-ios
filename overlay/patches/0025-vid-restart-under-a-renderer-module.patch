+
+#if defined( OPENQ4_RENDERER_VK_MODULE ) && defined( OPENQ4_RENDERER_MODULE_STATIC ) && defined( __APPLE__ ) && TARGET_OS_IPHONE
+/*
+ * openQ4-ios (D-118). The Vulkan module's glConfig is thread_local since
+ * v0.14.1 (its render thread works from a copy). The iOS shell initialises the
+ * renderer on the MAIN thread and runs every later frame on its engine thread,
+ * where glConfig would start zeroed: isInitialized false, so EndFrame returns
+ * before issuing a single command and the screen freezes on the last frame
+ * init presented. The main thread snapshots its config once init is done and
+ * the engine thread adopts it before its first frame (beside the renderer
+ * owner hand-off, overlay 0029). Any later renderer restart runs on the engine
+ * thread and writes the engine thread's copy, which is the one frames read.
+ */
+static glconfig_t	r_iosConfigHandoff;
+static bool			r_iosConfigHandoffValid = false;
+
+extern "C" void OpenQ4_iOS_SnapshotRendererConfig( void ) {
+	r_iosConfigHandoff = glConfig;
+	r_iosConfigHandoffValid = true;
+}
+
+extern "C" int OpenQ4_iOS_AdoptRendererConfig( void ) {
+	if ( !r_iosConfigHandoffValid ) {
+		return 0;
+	}
+	glConfig = r_iosConfigHandoff;
+	return 1;
+}
 #endif
 
