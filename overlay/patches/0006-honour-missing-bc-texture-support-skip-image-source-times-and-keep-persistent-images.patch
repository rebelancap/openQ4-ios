+/*
+ * image_skipSourceTimeChecks — the image half of com_productionMode, and only
+ * that half (openQ4-ios D-109).
+ *
+ * Production mode skips every image SOURCE-timestamp revalidation: the image
+ * program re-parse and source stat that prove a cached generated/ image is not
+ * older than its source, and the one that proves a preferred DDS is not older
+ * than the TGA it replaces. On the iOS simulator that was ~4.6 s of a map load.
+ * But com_productionMode also makes the generated-cache accept test skip
+ * R_GeneratedImageHeaderMatchesDerivedOpts (any supported header is taken, even
+ * one built for another size or format — a quality-preset change would then be
+ * served the old cache), and that is not a timestamp check. This cvar takes the
+ * timestamp skips and leaves the header match alone.
+ *
+ * Staleness is then the caller's job: the iOS shell wipes generated/ whenever
+ * the executable, the active mod or the set of pk4s changes, and turns this off
+ * outright whenever user content beyond retail is present (a mod, an extra pk4,
+ * loose files), because a TGA override older than nothing still has to beat a
+ * retail DDS and only the timestamp check knows that.
+ */
+static idCVar image_skipSourceTimeChecks( "image_skipSourceTimeChecks", "0", CVAR_RENDERER | CVAR_BOOL,
+	"skip image source-timestamp revalidation (cached generated images and preferred DDS staleness); "
+	"the caller guarantees the cache is fresh" );
+
+static bool R_SkipImageSourceTimeChecks() {
+	return fileSystem->InProductionMode() || image_skipSourceTimeChecks.GetBool();
 }
 
