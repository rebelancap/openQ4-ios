+
+#if defined( __APPLE__ ) && TARGET_OS_IPHONE
+// openQ4-ios (D-118): the iOS engine thread owns retained-UI edits after the
+// main thread ran RetainedUI_Init (Common.cpp OpenQ4_iOS_AdoptEngineThreadIdentity).
+void RetainedUI_iOS_AdoptEditThread() {
+	editThread = std::this_thread::get_id();
+	// Every view made during init (title, load game, credits, demos, arena,
+	// multiplayer, create server, join game, the HUD) owns a canvas bound to the
+	// init thread. Unadopted, each one reports an active callback on the engine
+	// thread (Runtime::HasActiveCanvasCallback), which makes BusyEditCanvas()
+	// true, RefreshResources() false and every view refuse to prepare, draw or
+	// be created: the black main menu of D-118/D-122.
+	int adopted = 0;
+	for (auto* view : views) if (view && view->runtime) { view->runtime->iOS_AdoptCanvasThread(); ++adopted; }
+	common->Printf("iOS: retained UI adopted %d view canvas(es) on the engine thread\n", adopted);
+}
+#endif
