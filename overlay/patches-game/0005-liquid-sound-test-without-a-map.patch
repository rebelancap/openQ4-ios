 static bool OpenQ4_SoundPointInLiquid( const idVec3 &point ) {
+	// openQ4-ios D-122: the sound world keeps this pointer after the map is gone,
+	// and a render-demo replayed right after a game map (record, disconnect,
+	// playDemo) updated emitters with no clip world: idGameLocal::Contents read
+	// clip[0] of an empty list (SIGSEGV, sim-verified with lldb). No map, no
+	// liquid. Upstreaming candidate.
+	if ( gameLocal.GameState() != GAMESTATE_ACTIVE ) {
+		return false;
+	}
 	return gameLocal.LiquidContentsAtPoint( point, NULL ) != 0;
 }
